# Environment Configuration Example

# MQTT Settings
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883
MQTT_TOPIC_EEG_STREAM=hospital/patient/eeg/stream
MQTT_TOPIC_ALERTS=hospital/patient/eeg/alerts
MQTT_TOPIC_MODEL_OTA=hospital/edge/models/ota

# Hospital Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# TimescaleDB / PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=eeg_hospital_secure_password
POSTGRES_DB=eeg_hospital_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Edge Device Configuration
EDGE_DEVICE_ID=rpi5_patient_node_01
MODEL_PATH=edge/models/seizure_detector.tflite
